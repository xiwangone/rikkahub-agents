<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ 的「每应用语言」：系统设置 → 应用 → 本应用 → 语言，
  用户可为本应用单独选择语言，无需应用内自建选择器。
  标签使用 BCP 47；资源目录对应关系：
    en       → values
    zh-Hans  → values-zh（简体）
    zh-HK    → values-zh-rHK（繁体，香港用词）
    ja       → values-ja
    ko-KR    → values-ko-rKR
    ru       → values-ru
    ar       → values-ar
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en"/>
    <locale android:name="zh-Hans"/>
    <locale android:name="zh-HK"/>
    <locale android:name="ja"/>
    <locale android:name="ko-KR"/>
    <locale android:name="ru"/>
    <locale android:name="ar"/>
</locale-config>
