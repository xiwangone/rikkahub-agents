<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="128dp"
            android:height="128dp"
            android:viewportWidth="100"
            android:viewportHeight="100">
            <group
                android:name="ring_group"
                android:pivotX="50"
                android:pivotY="50">
                <path
                    android:name="ring"
                    android:pathData="M50,9 A41,41 0 1,1 49.9,9"
                    android:strokeColor="#333333"
                    android:strokeWidth="6.5"
                    android:strokeLineCap="round"
                    android:trimPathStart="0"
                    android:trimPathEnd="0.74" />
            </group>
            <path
                android:name="glyph"
                android:pathData="M41,45 L40,30 C40,26 46,26 47,30 L49,41 L51,41 L53,30 C54,26 60,26 60,30 L59,45 L67,54 L65,67 L56,74 L44,74 L35,67 L33,54 Z"
                android:strokeColor="#333333"
                android:strokeWidth="5.5"
                android:strokeLineJoin="round" />
        </vector>
    </aapt:attr>
    <target android:name="ring_group">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:duration="1400"
                android:valueFrom="0"
                android:valueTo="360"
                android:repeatCount="infinite" />
        </aapt:attr>
    </target>
    <target android:name="glyph">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:duration="1200"
                android:valueFrom="1.0"
                android:valueTo="0.35"
                android:repeatCount="infinite"
                android:repeatMode="reverse" />
        </aapt:attr>
    </target>
</animated-vector>
