<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <!-- 环 + 爻：外圈缺口环持续流转，中心真「爻」字（上乂 + 中横 + 下乂）依次呼吸 -->
    <aapt:attr name="android:drawable">
        <vector
            android:width="128dp"
            android:height="128dp"
            android:viewportWidth="100"
            android:viewportHeight="100">

            <!-- 外环（缺口环，旋转时形成流动感）：rotation 必须挂在 group 上 -->
            <group
                android:name="ring_group"
                android:pivotX="50"
                android:pivotY="50">
                <path
                    android:name="ring"
                    android:pathData="M50,9 A41,41 0 1,1 49.9,9"
                    android:strokeColor="#333333"
                    android:strokeWidth="6.5"
                    android:strokeLineCap="round"
                    android:trimPathStart="0"
                    android:trimPathEnd="0.74" />
            </group>

            <!-- 爻·上「乂」 -->
            <path
                android:name="yin_top"
                android:pathData="M63,25 C54,32 42,39 29,43 M36,25 L59,39 M64,41.5 L69,43.5"
                android:strokeColor="#333333"
                android:strokeWidth="6.8"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />

            <!-- 爻·中横「一」 -->
            <path
                android:name="yin_bot"
                android:pathData="M33,49.5 L57,49.5"
                android:strokeColor="#333333"
                android:strokeWidth="6.8"
                android:strokeLineCap="round" />

            <!-- 爻·下「乂」 -->
            <path
                android:name="yang"
                android:pathData="M63,49.5 C58,62 46,71 29,76 M39,55 L50,65 M55,69 L68,75"
                android:strokeColor="#333333"
                android:strokeWidth="6.8"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
        </vector>
    </aapt:attr>

    <!-- 环持续旋转（trimPath 缺口在转）——目标必须是 group（path 不支持 rotation） -->
    <target android:name="ring_group">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:duration="1400"
                android:valueFrom="0"
                android:valueTo="360"
                android:repeatCount="infinite" />
        </aapt:attr>
    </target>

    <!-- 上乂、中横、下乂三段依次呼吸 -->
    <target android:name="yin_top">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:duration="1200"
                android:valueFrom="1.0"
                android:valueTo="0.3"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:startOffset="0" />
        </aapt:attr>
    </target>

    <target android:name="yin_bot">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:duration="1200"
                android:valueFrom="1.0"
                android:valueTo="0.3"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:startOffset="400" />
        </aapt:attr>
    </target>

    <target android:name="yang">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:duration="1200"
                android:valueFrom="1.0"
                android:valueTo="0.3"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:startOffset="800" />
        </aapt:attr>
    </target>
</animated-vector>
