# Sibling clones of upstream projects used as references during development
/termux-api/

# Sensitive build inputs (signed-in service account / Firebase config)
app/google-services.json
# Release artifacts staged for GitHub release uploads — debug-signed APKs are
# regenerated each release; no need to track them in git.
/release-artifacts/

# Release signing keystore — never commit
/rikkahub-release.jks

# Local planning doc — not for the remote
/enhance.md

# Separate companion repo - cloned locally, not part of this repo
/agent-keyboard/

# Generated baseline profiles (baseline profiling dropped in this fork)
/app/src/release/generated/
# Synaptic 图谱产物(本机生成,不入库)
/synaptic-out/

# agent-tools 子项目构建产物(嵌套路径,/build 不匹配,需单独忽略)
agent-tools/build/
# 备份文件不入库(*.bak 及 *.bak-日期 命名)
*.bak
*.bak-*
# bun.lock is generated from the tracked pnpm-lock.yaml on clean checkouts
/web-ui/bun.lock
